# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/
dist/

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
coverage.out
coverage.html

# Dependency directories
vendor/

# Go workspace file
go.work
go.work.sum

# Environment variables
.env
.env.local

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Build artifacts
*.log
tmp/
temp/

# Application specific
/ccdash

# Machine-local runtime state (not source, churns on every session/build)
.ccdash/tokens.db
.ccdash/tokens.db-shm
.ccdash/tokens.db-wal
.beads/traces/
.beads/heartbeats.jsonl
.needle-predispatch-sha

# Compiled release binaries belong on GitHub Releases, never in git history
/releases/
/ccdash-test

# Local NEEDLE and bead runtime state
.needle-predispatch-sha
.beads/events.jsonl
.beads/heartbeats.jsonl
.beads/diagnostics/
.beads/logs/
.beads/traces/
.beads/receipts/
.beads/*.db
.beads/*.db-shm
.beads/*.db-wal
.beads/*.db.backup.*
.beads/*.lock
.beads/*.tmp
.beads/*.temp
.beads/*.journal
.br_recovery/
